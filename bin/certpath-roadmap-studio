#!/usr/bin/env python3
"""CertPath Roadmap Studio v2.6.0 — Unified ZothOS CLI Wrapper.
Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform
Resolves /opt/certpath-roadmap-studio first (Live ISO / system install) with $HOME fallback.
"""
from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import urllib.request
from pathlib import Path

TOOL_ID = "certpath-roadmap-studio"
TOOL_REPO = "certpath-roadmap-studio"
TOOL_NAME = "CertPath Roadmap Studio"
TOOL_DESC = (
    "137-credential certification DAG solver, 8-role career roadmap planner, "
    "Monte Carlo P50/P80/P95 velocity simulator, financial ROI & skill-overlap engine, "
    "and 12-tool stdlib MCP server. 100% free and open-access."
)
TOOL_VERSION = "2.6.0"
TOOL_CATEGORY = "Automation"
TOOL_PORT = 8093
STUDIO_URL = f"http://127.0.0.1:3000/tools/{TOOL_ID}"
LOCAL_PORT_URL = f"http://127.0.0.1:{TOOL_PORT}"


def resolve_repo_dir() -> Path:
    candidates = [
        Path("/opt/certpath-roadmap-studio"),
        Path.home() / "NullAITech" / "certpath-roadmap-studio",
        Path(__file__).resolve().parent.parent,
    ]
    for c in candidates:
        if (c / "src" / "certpath_roadmap_studio" / "cli.py").exists():
            return c
    return candidates[0]


def check_daemon() -> bool:
    try:
        with urllib.request.urlopen(f"{LOCAL_PORT_URL}/api/health", timeout=1.5) as r:
            return r.status == 200
    except Exception:
        return False


def main() -> None:
    repo_dir = resolve_repo_dir()
    pkg_dir = repo_dir / "src"
    py_cli = pkg_dir / "certpath_roadmap_studio" / "cli.py"
    args = sys.argv[1:]

    if "--electron" in args or (args and args[0] in ("desktop", "electron")):
        rem = [a for a in args if a not in ("--electron", "desktop", "electron")]
        elec = shutil.which("electron") or "/usr/local/bin/electron"
        sys.exit(subprocess.run([elec, str(repo_dir / "electron" / "main.cjs")] + rem, cwd=str(repo_dir)).returncode)

    if "--tui" in args or (args and args[0] == "tui"):
        rem = [a for a in args if a not in ("--tui", "tui")]
        tui_bin = shutil.which(f"{TOOL_ID}-tui") or f"/usr/local/bin/{TOOL_ID}-tui"
        sys.exit(subprocess.run([tui_bin] + rem).returncode)

    if args and args[0] == "web":
        args = ["serve", "--host", "127.0.0.1", "--port", str(TOOL_PORT)] + args[1:]

    if py_cli.exists() and args and args[0] not in ("--status", "--info", "--ui", "--studio", "--json", "--version"):
        env = os.environ.copy()
        env["PYTHONPATH"] = str(pkg_dir) + (os.pathsep + env["PYTHONPATH"] if env.get("PYTHONPATH") else "")
        res = subprocess.run([sys.executable, "-m", "certpath_roadmap_studio.cli"] + args, cwd=str(repo_dir), env=env)
        sys.exit(res.returncode)

    parser = argparse.ArgumentParser(
        prog=TOOL_ID,
        description=f"{TOOL_NAME} (v{TOOL_VERSION}) — {TOOL_DESC}",
    )
    parser.add_argument("--version", action="version", version=f"{TOOL_ID} v{TOOL_VERSION}")
    parser.add_argument("--status", action="store_true", help="Check local installation & :8093 daemon status")
    parser.add_argument("--json", action="store_true", help="Output deterministic JSON telemetry")
    parser.add_argument("--ui", action="store_true", help="Print local workbench URL")
    parser.add_argument("payload", nargs="*", help="Optional subcommand")
    parsed, _ = parser.parse_known_args(args)

    online = check_daemon()
    info = {
        "id": TOOL_ID,
        "repo": TOOL_REPO,
        "name": TOOL_NAME,
        "version": TOOL_VERSION,
        "category": TOOL_CATEGORY,
        "installed": py_cli.exists(),
        "repo_path": str(repo_dir),
        "native_cli": str(py_cli),
        "studio_workbench_url": STUDIO_URL,
        "local_endpoint": LOCAL_PORT_URL,
        "daemon_online": online,
        "license": "MIT — 100% Free & Open Access (Zero Paywalls)",
        "attribution": "Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform",
        "support": {
            "stripe_buy_coffee": "https://buy.stripe.com/3cIfZg27PdKo2D64Ocfw40X",
            "solana_wallet": "GG2eQbVh8ut1BK6j1A2tz7pSySdLpD38BgyEhGcxdXoK",
        },
        "status": "ONLINE" if online else "READY",
    }

    if parsed.json:
        print(json.dumps(info, indent=2))
        return

    if parsed.ui:
        print(LOCAL_PORT_URL)
        return

    print(f"✦ {TOOL_NAME} (v{TOOL_VERSION}) — [{TOOL_CATEGORY}]")
    print(f"  Runtime    : {repo_dir}")
    print(f"  Workbench  : {STUDIO_URL}")
    print(f"  Local Port : {LOCAL_PORT_URL}")
    print(f"  Daemon     : {'ONLINE (Healthy :8093)' if online else 'OFFLINE (run: certpath serve --host 127.0.0.1 --port 8093)'}")
    print("  Access     : 100% Free & Open Access (MIT)")
    print("  Engineered : Neal Frazier Tech (@1nc0gn30) • NullAI Platform")


if __name__ == "__main__":
    main()
