[Desktop Entry]
Version=1.0
Type=Application
Name=CertPath Roadmap Studio
GenericName=Certification Roadmap DAG Solver & ROI Calculator
Comment=Interactive Cybersecurity & Cloud Certification Roadmap Studio, Career Path DAG Solver & ROI Calculator
Exec=/usr/local/bin/certpath desktop
Icon=certpath
Terminal=false
Categories=Education;Development;System;Utility;
StartupNotify=true
Actions=CLI;Web;

[Desktop Action CLI]
Name=Open CertPath CLI
Exec=x-terminal-emulator -e "/usr/local/bin/certpath --help"

[Desktop Action Web]
Name=Open Web UI (Port 8093)
Exec=/usr/local/bin/certpath web
